{
  "name": "Mosaïque — laboratoire configurateur",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "postStartCommand": "bash .devcontainer/ensure-vite.sh",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Aperçu privé — La marche des privilèges",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "afterDelay"
      }
    }
  },
  "postAttachCommand": "bash .devcontainer/ensure-vite.sh"
}
