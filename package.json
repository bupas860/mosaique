{
  "name": "mosaique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "understand:validate": "node scripts/editorial-v2/validate-understand-v2.mjs",
    "understand:import": "node scripts/editorial-v2/import-understand-v2.mjs",
    "understand:check-public": "node scripts/editorial-v2/check-understand-public-v2.mjs",
    "understand:check-ui": "node scripts/editorial-v2/check-understand-ui-v2.mjs",
    "understand:check-dist": "node scripts/editorial-v2/check-understand-dist-v2.mjs",
    "biographies:validate": "node scripts/editorial-v2/validate-public-biographies-v2.mjs",
    "biographies:import": "node scripts/editorial-v2/import-public-biographies-v2.mjs",
    "biographies:check-public": "node scripts/editorial-v2/check-public-biographies-v2.mjs",
    "biographies:check-dist": "node scripts/editorial-v2/check-public-biographies-v2.mjs --dist",
    "editorial:check-runtime": "node scripts/editorial-v2/check-runtime-v2.mjs",
    "editorial:check-selection": "node scripts/editorial-v2/check-visible-obstacles-selection.mjs",
    "editorial:import": "node scripts/editorial-v2/import-editorial-v2.mjs",
    "editorial:validate": "node scripts/editorial-v2/validate-editorial-v2.mjs",
    "check:data-boundaries": "node scripts/check-data-boundaries.mjs",
    "check:bundle-boundaries": "node scripts/check-bundle-boundaries.mjs",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "check:public-navigation": "node scripts/check-public-navigation.mjs",
    "situations:generate-public": "node scripts/public-situations/generate.mjs",
    "check:public-situations": "node scripts/public-situations/check.mjs",
    "dev": "vite",
    "build": "npm run understand:validate && npm run understand:import && npm run understand:check-public && npm run understand:check-ui && npm run biographies:validate && npm run biographies:import && npm run biographies:check-public && tsc -b && vite build && npm run understand:check-dist && npm run biographies:check-dist",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
